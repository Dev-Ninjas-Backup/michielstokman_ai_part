# xAI (SuperGrok) API Key for LLM story generation
XAI_API_KEY="your_xai_api_key_here"

# SuperGrok model settings (all optional — defaults shown)
LLM_MODEL="grok-3"                    # grok-3-mini for faster/cheaper
LLM_TEMPERATURE_STORY="0.85"          # creativity for general stories
LLM_TEMPERATURE_CONFESSION="0.35"     # fidelity for Confessions (preserves complete user story, minimal edits)
LLM_TEMPERATURE_MEDITATION="0.35"     # fidelity for Meditations (preserves complete guidance & pacing)
LLM_MAX_TOKENS="8192"                 # max output tokens (supports long 1800-word stories)
LLM_TEMPERATURE_RESONANCE="0.7"       # focus for journaling questions

# ElevenLabs API Key for voice generation (TTS)
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"

# ElevenLabs voice settings (all optional — defaults shown)
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"    # Rachel — warm, professional female
ELEVENLABS_MODEL_ID="eleven_turbo_v2_5"   # 40k char limit (prevents crashes on long stories)
ELEVENLABS_STABILITY="0.65"                    # 0.0-1.0, higher = warmer/more consistent
ELEVENLABS_SIMILARITY_BOOST="0.80"             # 0.0-1.0, higher = more expressive
ELEVENLABS_STYLE="0.30"                        # 0.0-1.0, stylistic variation
TTS_PIPELINE_V2="false"                        # TTS Pipeline V2: emotional profiles, chunking, seamless stitching
TTS_SMOOTH_AUDIO="false"                       # Smooth audio: continuous room-tone bed, no break tags, even pace
# TTS_V2_MODEL_ID="eleven_multilingual_v2"     # Optional model override for V2 pipeline (defaults to ELEVENLABS_MODEL_ID, leave unset)
TTS_PACE_NORMALIZE="false"                     # Legacy pace normalize flag (off)

# Vector Database (Pinecone)
PINECONE_API_KEY="your_pinecone_api_key_here"
PINECONE_ENVIRONMENT="your_pinecone_environment"
PINECONE_INDEX_NAME="stories-rag"

# PostgreSQL Database
DB_USER="your_db_user"
DB_PASSWORD="your_db_password"
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="your_database_name"

# Cloud Storage (AWS S3)
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_REGION_NAME="us-east-1"
AWS_BUCKET_NAME="your_bucket_name"

# Cover generation pipeline (instantly revertible — flip env, no code change)
# "dalle"    = Grok IMAGE_PROMPT + full scrapbook collage via OpenAI Images
# "template" = HTML cover_template + OpenAI portrait in the photo hole
#              (product path for confession + meditation — client-approved layout)
COVER_GENERATION_METHOD="template"
# OpenAI image model used ONLY for the template photo-hole portrait.
# gpt-image-2 in production (long prompts accepted); dall-e-3 still supported.
OPENAI_IMAGE_MODEL="gpt-image-2"

# Stripe Settings
STRIPE_API_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Security (required when APP_ENV=production)
# SECRET_KEY="replace-with-a-long-random-string"
# APP_ENV="development"
# ALLOWED_ORIGINS="http://localhost:3000,https://transformtoliberation.com,https://www.transformtoliberation.com"

# App Frontend
FRONTEND_URL="http://localhost:3000"

# Social Auth
GOOGLE_CLIENT_ID="your_google_client_id_here"
APPLE_CLIENT_ID="your_apple_client_id_here"
