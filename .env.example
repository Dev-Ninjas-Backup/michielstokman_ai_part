# xAI (SuperGrok) API Key for LLM story generation
XAI_API_KEY="your_xai_api_key_here"

# SuperGrok model settings (all optional — defaults shown)
LLM_MODEL="grok-3"                    # grok-3-mini for faster/cheaper
LLM_TEMPERATURE_STORY="0.85"          # creativity for Confessions/Meditations/Transformations
LLM_TEMPERATURE_RESONANCE="0.7"       # focus for journaling questions

# ElevenLabs API Key for voice generation (TTS)
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"

# ElevenLabs voice settings (all optional — defaults shown)
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"    # Rachel — warm, professional female
ELEVENLABS_MODEL_ID="eleven_turbo_v2_5"   # 40k char limit (prevents crashes on long stories)
ELEVENLABS_STABILITY="0.65"                    # 0.0-1.0, higher = warmer/more consistent
ELEVENLABS_SIMILARITY_BOOST="0.80"             # 0.0-1.0, higher = more expressive
ELEVENLABS_STYLE="0.30"                        # 0.0-1.0, stylistic variation

# Vector Database (Pinecone)
PINECONE_API_KEY="your_pinecone_api_key_here"
PINECONE_ENVIRONMENT="your_pinecone_environment"

# PostgreSQL Database
DB_USER="your_db_user"
DB_PASSWORD="your_db_password"
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="your_database_name"

# Cloud Storage (AWS S3)
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_BUCKET_NAME="your_bucket_name"
